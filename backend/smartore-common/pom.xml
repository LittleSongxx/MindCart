<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.smartore</groupId>
    <artifactId>smartore-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>smartore-common</artifactId>
  <name>smartore-common</name>
  <description>跨服务共享的契约与基础设施：统一返回体、错误码、全局异常、
    网关信任头解析（用户上下文/内部令牌/traceId）、Feign 上下文透传、通用工具</description>

  <dependencies>
    <!-- 只依赖 spring-web（servlet 与 webflux 栈共享），不引 starter-web：
         gateway 是 WebFlux 应用，common 不能把 servlet 栈带进去 -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>
    <!-- GlobalExceptionHandler 需要 spring-dao（DuplicateKeyException 在 spring-tx 里） -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-tx</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <!-- 服务是 servlet 栈，编译期需要 servlet API；gateway 不用这个包里的 servlet 相关类 -->
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- Feign 上下文透传拦截器：仅在有 openfeign 的服务里生效（ConditionalOnClass） -->
    <dependency>
      <groupId>io.github.openfeign</groupId>
      <artifactId>feign-core</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- GlobalExceptionHandler 接管 ConstraintViolationException。
         只是校验 API（无传递依赖），Spring 启动时解析 @ExceptionHandler 方法签名就会加载该类型，
         因此不能是 provided：类缺失会让整个 advice 注册失败。 -->
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
    </dependency>
    <dependency>
      <groupId>cn.hutool</groupId>
      <artifactId>hutool-all</artifactId>
    </dependency>
    <dependency>
      <groupId>com.auth0</groupId>
      <artifactId>java-jwt</artifactId>
    </dependency>
    <!-- 共享缓存装配：optional 表示不向使用方传递，需要缓存的服务各自声明这两个 starter。
         这样 common 可以承载缓存基础设施，而不用把 Redis 强加给每个服务 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-cache</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- 接口文档的公共 OpenAPI 元信息：只用到 swagger-models 里的 OpenAPI/Info，
         由 springdoc 的 starter-common 传递进来（版本走 springdoc BOM） -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-common</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- 仅测试用：common 只依赖校验 API（运行期的 provider 由各服务的 starter-validation 提供），
         单测要跑真实的 ConstraintViolation 就得引入实现 -->
    <dependency>
      <groupId>org.hibernate.validator</groupId>
      <artifactId>hibernate-validator</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
