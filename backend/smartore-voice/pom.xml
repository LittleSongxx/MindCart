<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.smartore</groupId>
    <artifactId>smartore-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>smartore-voice</artifactId>
  <name>smartore-voice</name>
  <description>语音域：语音导购通道（ASR/TTS 双向流 + 语音意图编排 + pgvector 语义检索）。
    与 smartore-ai 共存分工——voice 独占语音 I/O 与语音会话编排，文本导购/RAG/管理面留在 ai。
    业务事实全部经 Feign /internal/** 取自 user/goods/trade，本地不建业务表（ADR-0011）。
    叶子服务，不拆 api 模块。</description>

  <properties>
    <agentscope.version>1.0.11</agentscope.version>
    <spring-ai-alibaba-agentscope.version>1.1.2.2</spring-ai-alibaba-agentscope.version>
    <dashscope.version>2.23.1</dashscope.version>
    <sentinel.version>1.8.8</sentinel.version>
    <hypersistence-utils.version>3.15.2</hypersistence-utils.version>
  </properties>

  <!-- 版本说明：本 BOM 传递托管的 spring-ai 构件版本（1.1.2.x 线）按"子 POM 优先"会盖过
       父 pom 的 spring-ai-bom:1.1.7。已用 dependency:list 核实本模块类路径上没有任何
       org.springframework.ai 构件（AgentScope 直连 OpenAI 兼容端点，不走 Spring AI 抽象），
       因此该覆盖对运行无影响；若未来引入 spring-ai 依赖，必须先核对两侧版本线。 -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.alibaba.cloud.ai</groupId>
        <artifactId>spring-ai-alibaba-bom</artifactId>
        <version>${spring-ai-alibaba-agentscope.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.smartore</groupId>
      <artifactId>smartore-common</artifactId>
    </dependency>
    <dependency>
      <groupId>com.smartore</groupId>
      <artifactId>smartore-user-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.smartore</groupId>
      <artifactId>smartore-goods-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.smartore</groupId>
      <artifactId>smartore-trade-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-cache</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <dependency>
      <groupId>com.alibaba.cloud</groupId>
      <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-openfeign</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-loadbalancer</artifactId>
    </dependency>

    <!-- AgentScope Java（多 Agent 编排） -->
    <dependency>
      <groupId>io.agentscope</groupId>
      <artifactId>agentscope-spring-boot-starter</artifactId>
      <version>${agentscope.version}</version>
    </dependency>
    <dependency>
      <groupId>com.alibaba.cloud.ai</groupId>
      <artifactId>spring-ai-alibaba-starter-agentscope</artifactId>
    </dependency>

    <!-- DashScope：ASR/TTS 实时语音 + Embedding + 语义精排 -->
    <dependency>
      <groupId>com.alibaba</groupId>
      <artifactId>dashscope-sdk-java</artifactId>
      <version>${dashscope.version}</version>
    </dependency>
    <dependency>
      <groupId>com.squareup.okio</groupId>
      <artifactId>okio</artifactId>
      <version>3.17.0</version>
    </dependency>

    <!-- PostgreSQL + pgvector（向量检索与语音会话状态） -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>io.hypersistence</groupId>
      <artifactId>hypersistence-utils-hibernate-63</artifactId>
      <version>${hypersistence-utils.version}</version>
    </dependency>

    <!-- Sentinel：LLM 链路熔断/限流（程序化 API，不依赖 aspectj） -->
    <dependency>
      <groupId>com.alibaba.csp</groupId>
      <artifactId>sentinel-core</artifactId>
      <version>${sentinel.version}</version>
    </dependency>
    <dependency>
      <groupId>com.alibaba.csp</groupId>
      <artifactId>sentinel-datasource-extension</artifactId>
      <version>${sentinel.version}</version>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
    </dependency>

    <dependency>
      <groupId>io.projectreactor</groupId>
      <artifactId>reactor-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
      <!-- 默认排除 @Tag("eval")（需要外部服务/真实 key），mvn test -P eval 才跑评测 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludedGroups>eval</excludedGroups>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>eval</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <excludedGroups combine.self="override"/>
              <groups>eval</groups>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
