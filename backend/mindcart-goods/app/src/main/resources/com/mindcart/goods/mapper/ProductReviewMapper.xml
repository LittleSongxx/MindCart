<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mindcart.goods.mapper.ProductReviewMapper">

    <select id="selectAll" resultType="com.mindcart.goods.entity.ProductReview">
        <!-- 跨库 JOIN 已拆：user_name 由服务层经 user 服务批量回填；order_no 属交易域，列表不再展示 -->
        select pr.*, p.name as product_name, p.product_no, p.cover_image
        from product_review pr
        left join product p on pr.product_id = p.id
        <where>
            <if test="userId != null"> and pr.user_id = #{userId}</if>
            <if test="orderId != null"> and pr.order_id = #{orderId}</if>
            <if test="orderItemId != null"> and pr.order_item_id = #{orderItemId}</if>
            <if test="productId != null"> and pr.product_id = #{productId}</if>
            <if test="rating != null"> and pr.rating = #{rating}</if>
            <if test="auditStatus != null"> and pr.audit_status = #{auditStatus}</if>
            <if test="productName != null"> and p.name like concat('%', #{productName}, '%')</if>
        </where>
        order by pr.id desc
    </select>


    <insert id="insert" parameterType="com.mindcart.goods.entity.ProductReview" useGeneratedKeys="true">
        insert into product_review
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="userId != null">user_id,</if>
            <if test="orderId != null">order_id,</if>
            <if test="orderItemId != null">order_item_id,</if>
            <if test="productId != null">product_id,</if>
            <if test="rating != null">rating,</if>
            <if test="content != null">content,</if>
            <if test="images != null">images,</if>
            <if test="auditStatus != null">audit_status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="userId != null">#{userId},</if>
            <if test="orderId != null">#{orderId},</if>
            <if test="orderItemId != null">#{orderItemId},</if>
            <if test="productId != null">#{productId},</if>
            <if test="rating != null">#{rating},</if>
            <if test="content != null">#{content},</if>
            <if test="images != null">#{images},</if>
            <if test="auditStatus != null">#{auditStatus},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateById" parameterType="com.mindcart.goods.entity.ProductReview">
        update product_review
        <set>
            <if test="rating != null">rating = #{rating},</if>
            <if test="content != null">content = #{content},</if>
            <if test="images != null">images = #{images},</if>
            <if test="auditStatus != null">audit_status = #{auditStatus},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        where id = #{id}
    </update>

</mapper>
