# MindCart 六个 Java 服务（含语音导购 voice）：单 systemd 单元顺序拉起（含前端静态托管由 nginx 承担，见 nginx 配置）
# 环境变量统一来自 /opt/mindcart/run/runtime.env（600 权限，gitignored）
[Unit]
Description=MindCart apps (gateway/user/goods/trade/ai/voice)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=forking
EnvironmentFile=/opt/mindcart/run/runtime.env
WorkingDirectory=/opt/mindcart/current
ExecStart=/opt/mindcart/current/ops/systemd/start-apps.sh
ExecStop=/opt/mindcart/current/ops/systemd/stop-apps.sh
Restart=on-failure
RestartSec=10
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
