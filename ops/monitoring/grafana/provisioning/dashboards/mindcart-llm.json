{
  "title": "MindCart LLM 调用画像",
  "uid": "mindcart-llm",
  "timezone": "browser",
  "refresh": "30s",
  "panels": [
    {
      "type": "stat", "title": "LLM 调用/分钟",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(mindcart_llm_call_seconds_count[5m])) * 60"}]
    },
    {
      "type": "stat", "title": "错误率",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "sum(rate(mindcart_llm_call_seconds_count{outcome=\"error\"}[5m])) / sum(rate(mindcart_llm_call_seconds_count[5m]))"}]
    },
    {
      "type": "timeseries", "title": "按调用类型 QPS（chat/embedding/agent）",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 5},
      "targets": [{"expr": "sum by (kind) (rate(mindcart_llm_call_seconds_count[5m]))", "legendFormat": "{{kind}}"}]
    },
    {
      "type": "timeseries", "title": "P95 耗时 by 模型",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 5},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, model) (rate(mindcart_llm_call_seconds_bucket[5m])))", "legendFormat": "{{model}}"}]
    }
  ]
}
